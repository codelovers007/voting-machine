<div class="events-page">
  <div class="events-header">
    <h1>All Events</h1>
    <p class="events-subtitle">Discover what's happening around you</p>
  </div>

  <div class="events-grid">
    <% @events.each do |event| %>
      <% counts    = @vote_counts[event.id] || { upvotes: 0, downvotes: 0 } %>
      <% user_vote = @user_votes[event.id] %>

      <div class="event-card">
        <div class="event-image-wrapper">
          <img src="<%= event.image_url %>" alt="<%= event.title %>" class="event-image">
          <div class="event-image-overlay"></div>
        </div>

        <div class="event-body">
          <h2 class="event-title"><%= event.title %></h2>

          <div class="event-dates">
            <div class="event-date">
              <span class="date-label">From</span>
              <span class="date-value"><%= event.start_date.strftime("%d %b %Y") %></span>
            </div>
            <div class="date-divider">→</div>
            <div class="event-date">
              <span class="date-label">To</span>
              <span class="date-value"><%= event.end_date.strftime("%d %b %Y") %></span>
            </div>
          </div>

          <p class="event-description">
            <%= truncate(event.description, length: 160) %>
          </p>

          <a href="<%= event.event_url %>" target="_blank" class="event-btn">
            View Event
          </a>

          <div class="vote-section">
            <%= button_to event_votes_path(event),
                  method: :post,
                  data: { turbo: false },
                  params: { vote_type: "upvote" },
                  class: "vote-btn upvote-btn #{user_vote == :upvoted ? 'active' : ''}" do %>
              <%= image_tag "thumb-up.png", width: 18, height: 18, alt: "Upvote" %>
              <%= counts[:upvotes] %>
            <% end %>

            <%= button_to event_votes_path(event),
                  method: :post,
                  data: { turbo: false },
                  params: { vote_type: "downvote" },
                  class: "vote-btn downvote-btn #{user_vote == :downvoted ? 'active' : ''}" do %>
              <%= image_tag "dislike.png", width: 18, height: 18, alt: "Downvote" %>
              <%= counts[:downvotes] %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="pagination-wrapper">
    <%= will_paginate @events %>
  </div>
</div>
